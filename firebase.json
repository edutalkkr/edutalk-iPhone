{
  "firestore": {"rules": "firestore.rules"},
  "functions": {"source": "functions"},
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]
      },
      {
        "source": "**/*.@(html)",
        "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]
      },
      {
        "source": "/",
        "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]
      }
    ]
  }
}
