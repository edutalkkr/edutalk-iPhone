# 결제 연동 설정 (배포 시 Firebase Functions 환경 변수로 등록)
# manual: 무통장 입금 주문 + 총관리자 입금 확인 (안전한 기본값)
# sandbox: 카드 결제 흐름을 실제 청구 없이 확인 (운영 환경에서는 사용하지 마세요)
# live: 결제 대행사 결제 창 + 웹훅 연동
PAYMENT_MODE=manual

# 무통장 입금 안내
BILLING_BANK_NAME=
BILLING_ACCOUNT_NUMBER=
BILLING_ACCOUNT_HOLDER=
BILLING_TRANSFER_GUIDE=입금자명을 학교명으로 남겨 주세요.
BILLING_DEPOSIT_DUE_HOURS=72

# live 모드에서 사용할 결제 창 주소 (https만 허용)
# 예: https://checkout.example.com/session
# orderId, orderNo, amount, plan 값이 쿼리로 자동 추가됩니다.
BILLING_CHECKOUT_URL=

# 결제 대행사 웹훅 서명 검증 키
# 웹훅 요청 본문을 HMAC-SHA256으로 서명한 값을 x-breeze-signature 헤더로 받습니다.
PAYMENT_WEBHOOK_SECRET=
