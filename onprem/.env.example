# 브리즈(Breeze) 온프레미스 서버 환경 변수 — 이 파일을 .env 로 복사하세요.
# (서버 폴더/서비스 exe 옆의 .env 를 자동으로 읽습니다. 이미 설정된 OS 환경 변수가 우선)
#
# ── AI 3줄 요약 (Gemini) — 로드맵 1-1 ────────────────────────────────────────
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 키를 여기에만 둡니다.
#  · 같은 공지는 서버가 딱 1회 Gemini를 호출해 DB(ai_summaries)에 저장하고,
#    이후 교사 앱에는 DB에서 즉시 돌려줍니다 → 중복 호출·비용·지연 제거.
#  · Gemini로 보내기 전 주민등록번호·휴대폰·카드번호를 ***로 마스킹합니다.
#  · AI 상담 일지(/api/consultations)도 같은 키를 쓰며, 전송 전 민감정보를 마스킹합니다.
#  · 키가 없으면 로컬 문장 추출 요약으로 자동 대체됩니다 (기능은 계속 동작).
GEMINI_API_KEY=
# 요약에 쓸 모델 (기본 gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ── 나이스(NEIS) 학사일정·급식 연동 — Killer ③ ───────────────────────────────
# 공공데이터포털(https://open.neis.go.kr)에서 키를 발급받아 여기에만 둡니다.
#  · 교사 앱은 서버(/api/neis/*)를 통해서만 조회합니다 — 키가 클라이언트에 노출되지 않아요.
#  · 결과는 school_cache에 잠시 보관(급식 6시간 · 학사일정 12시간)돼 재호출이 없습니다.
#  · 학교 코드는 관리자 페이지(/admin)의 [시스템 정책]에서 바꾸는 게 우선입니다(재시작 불필요).
NEIS_API_KEY=
# 교육청 코드 (예: B10 = 부산광역시교육청 · 서울은 B10 아님 — 나이스에서 확인)
NEIS_OFFICE_CODE=
# 학교 코드 (나이스 학교기본정보의 7자리, 예: 7010569)
NEIS_SCHOOL_CODE=

# ── 학생 웹 · 학교 코드 ──────────────────────────────────────────────────────
# 학생 웹은 http://<서버IP>:3000/student/ 에서 열립니다. 별도 환경변수는 없어요.
# 학교 코드·이름은 관리자 페이지(/admin)의 [학교 코드]에서 설정합니다.
# 학생은 학교 코드 + 학번 + 비밀번호로 로그인하고, 교사 앱과 같은 서버를 써야 해요.

# ── 서버 기본값 (선택) ───────────────────────────────────────────────────────
# EDUTALK_PORT=3000
# EDUTALK_DATA_DIR=              # 기본: 서버 폴더/data
# EDUTALK_LOG_DIR=               # 기본: 서버 폴더/logs
# EDUTALK_UPLOAD_DIR=            # 기본: 서버 폴더/uploads
# EDUTALK_LICENSE_PATH=          # 기본: 서버 폴더/license.key
# EDUTALK_ADMIN_TOKEN=           # 미지정 시 서버가 생성해 처음 1회 콘솔에 표시
# EDUTALK_STRICT_LICENSE=0       # 1이면 Ed25519 서명 라이선스만 허용 (권장: 운영 배포 시 1)

# ⚠️ 벤더 개인키는 서버에 두지 마세요. 라이선스 발급용 오프라인 PC에서만 사용합니다.
# EDUTALK_VENDOR_PRIVATE_KEY=    # 운영 서버에서는 비워 두세요.
# EDUTALK_LICENSE_SECRET=        # 레거시 HMAC 서명값 — 외부 노출 금지, 가능하면 Ed25519 사용
