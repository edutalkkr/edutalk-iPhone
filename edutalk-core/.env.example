# 브리즈(Breeze) 교사 앱 환경 변수 — 이 파일을 .env 로 복사해서 값을 채우세요.
# .env 는 절대 저장소에 올리지 않습니다 (.gitignore 에 포함).
#
# ── AI 공지 3줄 요약 (로드맵 1-1: 서버 이전 완료) ─────────────────────────────
# 보안 강화를 위해 AI API 키는 "교사 앱"이 아니라 온프레미스 서버의
# .env에서만 관리합니다.
#  · 서버가 같은 공지를 딱 1회 요약해 DB에 캐싱 → 교사 앱은 즉시 표시
#  · Gemini로 보내기 전 주민등록번호·휴대폰·카드번호를 ***로 마스킹
#  · 서버가 없거나 실패하면 앱이 로컬 문장 추출 요약으로 조용히 대체합니다
#
# 따라서 이 파일에는 API 키를 넣지 마세요.
# 서버 설정 방법: onprem/.env.example 참고
#
# ── 학교 이용권 상태 동기화 (선택) ────────────────────────────────────────────
# 학교 문서의 이용권 상태를 읽을 때 쓰는 공개 웹 앱 식별자입니다. 서비스 계정 키가 아니며,
# 접근 제어는 Firestore 규칙과 클라우드 콘솔의 API 키 제한으로 합니다.
# 값이 없으면 앱은 전체 기능 기본값으로 동작하고 이용권 동기화만 조용히 건너뜁니다.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
# 시간표 화면의 공개 웹 열기 주소 (기본값: https://edutalk.cloud)
VITE_PUBLIC_WEB_URL=
